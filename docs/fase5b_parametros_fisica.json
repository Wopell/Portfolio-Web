  },
  {
    "componente": "Ondas por Cápsula",
    "parametro": "minDist (Cápsula)",
    "valorOriginal": "Ortogonal mínima",
    "formula": "ba = end - start; pa = p - start; h = clamp(dot(pa,ba)/dot(ba,ba), 0, 1); dist = length(p - (start + ba*h))",
    "descripcion": "Distancia ortogonal más cercana al segmento cilíndrico/cápsula."
  },
  {
    "componente": "Ondas por Cápsula",
    "parametro": "waveSpeed (Base)",
    "valorOriginal": "110 * dpr px/s",
